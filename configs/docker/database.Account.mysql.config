<?xml version="1.0" encoding="utf-8"?>
<!--
  DiIiS-NA – Account database connection config for the Docker/MariaDB stack.

  "db" is the service name of the MariaDB container defined in docker-compose.mysql.yml.
  Update User ID / Password if you changed MARIADB_USER / MARIADB_PASSWORD there.
-->
<hibernate-configuration xmlns="urn:nhibernate-configuration-2.2">
  <session-factory>
    <property name="connection.provider">NHibernate.Connection.DriverConnectionProvider</property>
    <property name="dialect">DiIiS_NA.Core.Storage.MySqlDialect, Blizzless</property>
    <property name="connection.driver_class">DiIiS_NA.Core.Storage.MySqlConnectorDriver, Blizzless</property>
    <property name="use_proxy_validator">true</property>
    <property name="command_timeout">0</property>
    <property name="connection.connection_string">
      Server=db;Port=3306;Database=diiis;User ID=diiis;Password=changeme;CharSet=utf8mb4;
    </property>
    <property name="connection.release_mode">on_close</property>
    <property name="adonet.batch_size">0</property>
    <property name="max_fetch_depth">0</property>
    <property name="show_sql">false</property>
    <property name="format_sql">false</property>
  </session-factory>
</hibernate-configuration>
