##
## .env – Default credentials for the blizzless-diiis Docker Compose stacks.
##
## These values are used by both docker-compose.yml (PostgreSQL) and
## docker-compose.mysql.yml (MariaDB).  Override any variable here before
## starting the stack, or export it in your shell to avoid editing this file.
##
## ⚠️  IMPORTANT: Change ALL passwords to strong, unique values before
##     exposing the server to the internet or any untrusted network.
##

# ── MariaDB / MySQL stack (docker-compose.mysql.yml) ─────────────────────────
MARIADB_ROOT_PASSWORD=changeme
MARIADB_USER=diiis
MARIADB_PASSWORD=changeme

# ── PostgreSQL stack (docker-compose.yml) ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diablo
